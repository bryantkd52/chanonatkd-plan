{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chanonatkd.example/schemas/training-plan.schema.json",
  "title": "ChanonaTKD Training Plan",
  "description": "Contrato obligatorio para planes nuevos o modificados de ChanonaTKD. Las comprobaciones de URLs aprobadas, privacidad y audios de timing se ejecutan adicionalmente en scripts/validate-plan.js.",
  "type": "object",
  "required": [
    "updated_at",
    "nivel",
    "ciclo",
    "enfoque_corto",
    "enfoque",
    "chanonaflexDias",
    "chanonaflex",
    "isometricoDias",
    "isometrico",
    "pateoDias",
    "pateoTecnico",
    "poomsaeDias",
    "poomsae",
    "apuntes",
    "notasFinales"
  ],
  "additionalProperties": false,
  "properties": {
    "updated_at": {
      "$ref": "#/$defs/nonEmptyText"
    },
    "nivel": {
      "$ref": "#/$defs/nonEmptyText"
    },
    "ciclo": {
      "$ref": "#/$defs/nonEmptyText"
    },
    "enfoque_corto": {
      "$ref": "#/$defs/nonEmptyText"
    },
    "enfoque": {
      "$ref": "#/$defs/nonEmptyText"
    },
    "chanonaflexDias": {
      "$ref": "#/$defs/nonEmptyText"
    },
    "chanonaflex": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/resource"
      }
    },
    "isometricoDias": {
      "$ref": "#/$defs/nonEmptyText"
    },
    "isometrico": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/resource"
      }
    },
    "pateoDias": {
      "$ref": "#/$defs/nonEmptyText"
    },
    "pateoTecnico": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/resource"
      }
    },
    "poomsaeDias": {
      "$ref": "#/$defs/nonEmptyText"
    },
    "poomsae": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/resource"
      }
    },
    "indicacionesExtras": {
      "description": "Sección opcional de indicaciones textuales sin video, visible como Indicaciones extras en la plataforma.",
      "$ref": "#/$defs/textList"
    },
    "extras": {
      "description": "Sección opcional; usar únicamente cuando Bryan la solicite o ya exista en el plan actualizado.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/resource"
      }
    },
    "apuntes": {
      "$ref": "#/$defs/textList"
    },
    "notasFinales": {
      "$ref": "#/$defs/textList"
    },
    "clasesGrabadas": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/resource"
      }
    },
    "sistemaTabs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/systemTab"
      }
    }
  },
  "$defs": {
    "nonEmptyText": {
      "type": "string",
      "minLength": 1
    },
    "textList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonEmptyText"
      }
    },
    "resource": {
      "type": "object",
      "required": [
        "titulo",
        "tipo"
      ],
      "additionalProperties": false,
      "properties": {
        "titulo": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "dia": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "enfoque": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "reps": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "tipo": {
          "type": "string",
          "enum": [
            "video",
            "audio",
            "folder",
            "info"
          ]
        },
        "url": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyText"
          }
        },
        "boton": {
          "$ref": "#/$defs/nonEmptyText"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "tipo": {
                "const": "info"
              }
            }
          },
          "then": {
            "required": [
              "enfoque"
            ],
            "not": {
              "required": [
                "url"
              ]
            }
          },
          "else": {
            "required": [
              "url"
            ]
          }
        }
      ]
    },
    "systemTab": {
      "type": "object",
      "required": [
        "id",
        "titulo"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "titulo": {
          "type": "string"
        },
        "subtitulo": {
          "type": "string"
        },
        "descripcion": {
          "type": "string"
        },
        "recomendacion": {
          "type": "string"
        },
        "calentamientoTitulo": {
          "type": "string"
        },
        "chanonaflexDias": {
          "type": "string"
        },
        "isometricoDias": {
          "type": "string"
        },
        "pateoDias": {
          "type": "string"
        },
        "poomsaeDias": {
          "type": "string"
        },
        "calentamiento": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resource"
          }
        },
        "chanonaflex": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resource"
          }
        },
        "isometrico": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resource"
          }
        },
        "pateoTecnico": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resource"
          }
        },
        "poomsae": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resource"
          }
        },
        "clasesGrabadas": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resource"
          }
        },
        "frecuencias": {
          "$ref": "#/$defs/textList"
        },
        "indicacionesExtras": {
          "$ref": "#/$defs/textList"
        },
        "notasFinales": {
          "$ref": "#/$defs/textList"
        }
      }
    }
  }
}
